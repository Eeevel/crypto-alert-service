<%= form_with(model: alert, class: "needs-validation") do |f| %>
  <div class="mb-3">
    <%= f.label :symbol, class: "form-label" %>
    <%= f.text_field :symbol, class: "form-control", placeholder: "BTCUSDT" %>
  </div>

  <div class="mb-3">
    <%= f.label :threshold, class: "form-label" %>
    <%= f.number_field :threshold, step: "0.00000001", class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= f.label :direction, class: "form-label" %>
    <%= f.select :direction, Alert.directions.keys.map { |k| [k.titleize, k] }, {}, class: "form-select" %>
  </div>

  <div class="mb-3">
    <%= f.label :notification_channel_ids, "Notification Channels", class: "form-label" %>
    <%= f.collection_select :notification_channel_ids, NotificationChannel.all, :id, :name, {}, { multiple: true, class: "form-select" } %>
  </div>

  <div class="form-check form-switch mb-3">
    <%= f.check_box :active, class: "form-check-input", role: "switch" %>
    <%= f.label :active, "Active", class: "form-check-label" %>
  </div>

  <%= f.submit class: "btn btn-primary" %>
<% end %>
